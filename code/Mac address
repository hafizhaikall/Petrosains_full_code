#include <esp_now.h>
#include <WiFi.h>
#include <esp_wifi.h>

// REPLACE WITH MAC ADDRESS OF ESP32 #3
uint8_t esp3_MacAddress[] = {0x24, 0x6F, 0x28, 0xAB, 0xCD, 0xEF};

typedef struct struct_message {
  int store_id;
  char item_name[32];
  char category[32];
  int quantity;
  char status[16];
  int items_in;
  int items_out;
} struct_message;

struct_message localData;
esp_now_peer_info_t peerInfo;

void OnDataRecv(const uint8_t * mac, const uint8_t *incomingData, int len) {
  struct_message relayedData;
  memcpy(&relayedData, incomingData, sizeof(relayedData));
  // Forward packet to ESP32 #3
  esp_now_send(esp3_MacAddress, (uint8_t *) &relayedData, sizeof(relayedData));
}

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_STA);
  esp_wifi_set_protocol(WIFI_IF_STA, WIFI_PROTOCOL_LR);

  if (esp_now_init() != ESP_OK) return;

  esp_now_register_recv_cb(esp_now_recv_cb_t(OnDataRecv));

  memcpy(peerInfo.peer_addr, esp3_MacAddress, 6);
  peerInfo.channel = 1;
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);
}

void loop() {
  if (Serial.available() > 0) {
    String incoming = Serial.readStringUntil('\n');
    incoming.trim();

    int idx1 = incoming.indexOf(',');
    int idx2 = incoming.indexOf(',', idx1 + 1);
    int idx3 = incoming.indexOf(',', idx2 + 1);
    int idx4 = incoming.indexOf(',', idx3 + 1);
    int idx5 = incoming.indexOf(',', idx4 + 1);

    if (idx1 > 0 && idx5 > 0) {
      localData.store_id = 3; 
      incoming.substring(0, idx1).toCharArray(localData.item_name, 32);
      incoming.substring(idx1 + 1, idx2).toCharArray(localData.category, 32);
      localData.quantity = incoming.substring(idx2 + 1, idx3).toInt();
      incoming.substring(idx3 + 1, idx4).toCharArray(localData.status, 16);
      localData.items_in = incoming.substring(idx4 + 1, idx5).toInt();
      localData.items_out = incoming.substring(idx5 + 1).toInt();

      esp_now_send(esp3_MacAddress, (uint8_t *) &localData, sizeof(localData));
    }
  }
}


